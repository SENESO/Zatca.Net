<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A clean, modern .NET SDK for Saudi Arabia's ZATCA e-invoicing (Fatoora) Phase 2: TLV QR generation, invoice hashing, ECDSA signing primitives, onboarding and clearance/reporting API clients.</Description>
    <AssemblyTitle>Zatca.Net</AssemblyTitle>
    <Authors>Eslam Ashraf;Github Contributors</Authors>
    <PackageTags>zatca;fatoora;einvoicing;saudi-arabia;ksa;sdk;dotnet</PackageTags>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Zatca.Net</PackageId>
    <RootNamespace>Zatca</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
